# The package of LinSCP for Arch Linux, built from the checkout this file is
# in (LINSCP_SOURCE overrides it):
#   cd packaging/arch && makepkg -si
pkgname=linscp
_source="${LINSCP_SOURCE:-$(realpath "${startdir}/../..")}"
# LinSCP's version of the checkout (project() in CMakeLists.txt)
pkgver=$(sed -n '/^project(LinSCP/,/)/s/^ *VERSION \([0-9.]*\).*/\1/p' "${_source}/CMakeLists.txt")
pkgrel=1
pkgdesc='SFTP, SCP, FTP, WebDAV and S3 client with a two-panel file manager (a port of WinSCP)'
arch=('x86_64' 'aarch64')
url='https://github.com/mikigal/linscp'
license=('GPL-3.0-or-later')
depends=('expat' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'openssl' 'qt6-base' 'qt6-svg' 'qt6-wayland')
makedepends=('clang' 'cmake' 'ninja' 'python')
optdepends=(
  'openssh: opening sessions in ssh'
  'putty: opening sessions in PuTTY'
  'qt6-translations: translations of the standard dialogs'
  'xdg-utils: the default handler of the URLs of the protocols'
  'libcanberra: the sound once an operation completes'
)
# The core relies on Clang's extensions, the options of LTO differ
options=('!lto')

build() {
  cmake -S "${_source}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DLINSCP_SANITIZE=OFF \
    -DLINSCP_BUILD_TESTS=OFF \
    -DLINSCP_BUILD_HARNESS=OFF \
    -DLINSCP_AUTOMATION=OFF \
    -DLINSCP_RELEASE_BUILD=ON
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
