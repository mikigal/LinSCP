# The test VM's setup, shared by provision.sh (on the VM) and testvm.py (the
# tests). Shell syntax: NAME=value, no quotes, no spaces around "=".

# The OpenSSH server of the tests (the system's one on port 22 is for root,
# so that no test can lock the provisioning out)
SSH_PORT=2222
# All test users have this password (test values for the test VM only)
SSH_PASSWORD=Linscp-test-1
# Password authentication only
SSH_PASSWORD_USER=tester
# Keyboard-interactive authentication only (PAM)
SSH_KBD_USER=kbdtester
# Keyboard-interactive, the password expired: PAM asks for a new one
SSH_EXPIRED_USER=expired
# Public key and password, both required
SSH_TWOFACTOR_USER=twofactor
# SFTP only, chrooted, password
SSH_CHROOT_USER=chrooted
# Public key or password, for /copyid (its authorized_keys is reset by the tests)
SSH_COPYID_USER=copyid

# The TLS certificate of the FTPS, WebDAV and S3 servers is self-signed
# (/etc/linscp/tls); the tests pass its fingerprint.

# FTP and FTPS: SSH_PASSWORD_USER logs in with SSH_PASSWORD, to its home.
# vsftpd (LIST): FTP and explicit FTPS on VSFTPD_PORT, implicit FTPS on
# VSFTPD_IMPLICIT_PORT
VSFTPD_PORT=21
VSFTPD_IMPLICIT_PORT=990
# ProFTPD (MLSD): FTP and explicit FTPS
PROFTPD_PORT=2121
# Pure-FTPd (MLSD): FTP and explicit FTPS
PUREFTPD_PORT=2122
# Passive data ports: 100 per server (vsftpd, vsftpd implicit, ProFTPD,
# Pure-FTPd), from this one
FTP_PASSIVE_PORTS_START=40000

# WebDAV: Basic authentication of SSH_PASSWORD_USER with SSH_PASSWORD; the
# root of each server is /srv/linscp/dav/<apache|nginx>, owned by www-data
APACHE_DAV_PORT=8080
APACHE_DAVS_PORT=8443
NGINX_DAV_PORT=8081
NGINX_DAVS_PORT=8444
# S3 (moto, objects in memory, path-style URLs): HTTP, and HTTPS through
# nginx; the access key is created when the server starts, see
# /etc/linscp/s3-credentials (ACCESS_KEY SECRET)
S3_PORT=9000
S3S_PORT=9443
