# The test VM's setup, shared by provision.sh (on the VM) and testvm.py (the
# tests). Shell syntax: NAME=value, no quotes, no spaces around "=".

# The OpenSSH server of the tests (the system's one on port 22 is for root,
# so that no test can lock the provisioning out)
SSH_PORT=2222
# All test users have this password (test values for the test VM only)
SSH_PASSWORD=Openscp-test-1
# Password authentication only
SSH_PASSWORD_USER=tester
# Keyboard-interactive authentication only (PAM)
SSH_KBD_USER=kbdtester
# Keyboard-interactive, the password expired: PAM asks for a new one
SSH_EXPIRED_USER=expired
# Public key and password, both required
SSH_TWOFACTOR_USER=twofactor
# SFTP only, chrooted, password
SSH_CHROOT_USER=chrooted
# Public key or password, for /copyid (its authorized_keys is reset by the tests)
SSH_COPYID_USER=copyid
