{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Debug, ASan+UBSan, tests, harness)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LINSCP_SANITIZE": "ON",
        "LINSCP_BUILD_TESTS": "ON",
        "LINSCP_BUILD_HARNESS": "ON",
        "LINSCP_AUTOMATION": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (RelWithDebInfo, no tests)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LINSCP_SANITIZE": "OFF",
        "LINSCP_BUILD_TESTS": "OFF",
        "LINSCP_BUILD_HARNESS": "OFF",
        "LINSCP_AUTOMATION": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "unit",
      "inherits": "dev",
      "filter": { "include": { "label": "unit" } }
    }
  ]
}
